# =============================================================================
# SaintsHub - All Saints Mushililie Management Platform
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to version control

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SaintsHub"
NEXT_PUBLIC_INSTITUTION_NAME="All Saints Mushililie"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database?schema=platform
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saintshub?schema=platform"

# Separate connection strings for each schema (optional, for direct access)
DATABASE_URL_SCHOOL="postgresql://postgres:postgres@localhost:5432/saintshub?schema=school"
DATABASE_URL_PARISH="postgresql://postgres:postgres@localhost:5432/saintshub?schema=parish"

# -----------------------------------------------------------------------------
# Authentication (Auth.js v5)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here-min-32-chars"
AUTH_URL=http://localhost:3000

# Email/Password auth - no additional config needed

# SMS OTP (Africa's Talking)
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="your-africastalking-api-key"
AFRICASTALKING_SENDER_ID="SAINTS"
# For production, register a sender ID or use shortcode

# TOTP 2FA - built-in, no extra config

# OAuth providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# M-Pesa Daraja (Safaricom)
# -----------------------------------------------------------------------------
# Sandbox credentials from https://developer.safaricom.co.ke/
MPESA_ENVIRONMENT=sandbox  # sandbox | production
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_PASSKEY="your-passkey"
MPESA_SHORTCODE="174379"  # Sandbox: 174379, Production: your paybill/till
MPESA_CALLBACK_URL="http://localhost:3000/api/webhooks/mpesa/callback"
MPESA_ACCOUNT_REFERENCE="SAINTS"

# -----------------------------------------------------------------------------
# SMS (Africa's Talking)
# -----------------------------------------------------------------------------
# Same credentials as SMS OTP above
# For production, ensure you have SMS credits and registered sender ID

# -----------------------------------------------------------------------------
# Email (Nodemailer - SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="noreply@allsaintsmushililie.or.ke"
SMTP_FROM_NAME="All Saints Mushililie"

# -----------------------------------------------------------------------------
# Redis (BullMQ for background jobs)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# For production with TLS: rediss://user:pass@host:port

# -----------------------------------------------------------------------------
# File Storage (S3-compatible - Supabase/Cloudflare R2/MinIO)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="saintshub"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9000/saintshub"

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_SCHOOL_ENABLED=true
FEATURE_PARISH_ENABLED=true
FEATURE_PAYROLL_ENABLED=false
FEATURE_BOARDING_ENABLED=false
FEATURE_TRANSPORT_ENABLED=false
FEATURE_LIBRARY_ENABLED=false
FEATURE_PROCUREMENT_ENABLED=false
FEATURE_PWA_ENABLED=true

# -----------------------------------------------------------------------------
# Kenya-Specific
# -----------------------------------------------------------------------------
NEXT_PUBLIC_COUNTRY_CODE=KE
NEXT_PUBLIC_CURRENCY=KES
NEXT_PUBLIC_CURRENCY_SYMBOL=KSh
NEXT_PUBLIC_TIMEZONE=Africa/Nairobi
NEXT_PUBLIC_DATE_FORMAT=dd/MM/yyyy
NEXT_PUBLIC_PHONE_FORMAT=+254

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Rate limiting (requests per window)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_API=100
RATE_LIMIT_API_WINDOW_MS=60000

# Encryption key for sensitive fields (32 bytes base64)
# Generate: openssl rand -base64 32
ENCRYPTION_KEY="your-32-byte-base64-encryption-key"

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saintshub_test?schema=platform"