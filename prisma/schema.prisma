 relatedId String // Related record ID
 details  String?
  createdAt DateTime @default(now())

  institution Institution @relation("InstitutionParishRelations", fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, type, relatedId])
  @@index([institutionId])
  @@index([type])
  @@map("parish_relations")
}

