enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  GRANDPARENT
  AUNT
  UNCLE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  WITHDRAWN
  ON_LEAVE
}

enum AdmissionStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  ASSESSED
  OFFER_EXTENDED
  ACCEPTED
  ENROLLED
  REJECTED
  WITHDRAWN
  WAITLISTED
}

enum GradeLevel {
  PP1
  PP2
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  FORM_1
  FORM_2
  FORM_3
  FORM_4
}

model Guardian {
  id              String   @id @default(cuid())
  institutionId   String
  userId          String?  @unique
  firstName       String
  lastName        String?
  otherNames      String?
  relationship    GuardianRelationship
  phone           String
  idNumber        String?
  idNumberVerified Boolean @default(false)
  occupation      String?
  employer        String?
  primaryPayer    Boolean  @default(false)
  pickupAuthorised Boolean @default(false)
  email           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution Institution @relation("InstitutionGuardians", fields: [institutionId], references: [id], onDelete: Cascade)
  user          User?     @relation("GuardianUsers", fields: [userId], references: [id], onDelete: SetNull)
  studentGuardians StudentGuardian[] @relation("StudentGuardians")

  @@index([institutionId])
  @@map("guardians")
}

model StudentGuardian {
  id                 String @id @default(cuid())
  institutionId      String
  studentId          String
  guardianId         String
  isPrimary          Boolean @default(false)
  primaryPayer       Boolean @default(false)
  canPickUp          Boolean @default(false)
  canCollectReports  Boolean @default(false)
  canAuthorizeAbsence Boolean @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  institution Institution @relation("InstitutionStudentGuardians", fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student   @relation("GuardianLinks", fields: [studentId], references: [id], onDelete: Cascade)
  guardian    Guardian  @relation("StudentGuardians", fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([institutionId])
  @@map("student_guardians")
}

model Admission {
  id               String   @id @default(cuid())
  institutionId    String
  studentId        String? @unique
  applicantFirstName String
  applicantLastName String?
  applicantOtherNames String?
  applicantEmail   String?
  applicantPhone   String?
  currentSchool    String?
  gradeApplyingFor GradeLevel
  source           String
  referredBy       String?
  notes            String?
  admissionStatus  AdmissionStatus @default(APPLIED)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institution Institution @relation("InstitutionAdmissions", fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student?  @relation("AdmissionStudent", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([admissionStatus])
  @@map("admissions")
}

model Enrolment {
  id          String @id @default(cuid())
  institutionId String
  studentId   String
  gradeId     String
  termId      String
  admissionId String?
  status      String @default("ACTIVE")
  enrolledAt  DateTime @default(now())
  withdrawnAt DateTime?

  institution Institution @relation("InstitutionEnrolments", fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student   @relation("StudentEnrolments", fields: [studentId], references: [id], onDelete: Cascade)
  grade       Grade     @relation("GradeEnrolments", fields: [gradeId], references: [id], onDelete: Cascade)
  term        Term      @relation("TermEnrolments", fields: [termId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([studentId])
  @@map("enrolments")
}

enum AdmissionSource {
  PORTAL
  WALK_IN
  REFERRAL
  AGENT
}

model Promotion {
  id             String   @id @default(cuid())
  institutionId  String
  academicYearId String
  termId         String
  gradeFrom      GradeLevel
  gradeTo        GradeLevel
  status         String   @default("PENDING")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution Institution @relation("InstitutionPromotions", fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation("AcademicYearPromotions", fields: [academicYearId], references: [id], onDelete: Cascade)
  term Term @relation("TermPromotions", fields: [termId], references: [id], onDelete: Cascade)
  promotedStudents PromotionStudent[] @relation("PromotionStudents")

  @@index([institutionId])
  @@index([status])
  @@map("promotions")
}

model PromotionStudent {
  id               String @id @default(cuid())
  promotionId      String
  studentId        String
  studentTargetGrade String
  status           String @default("PENDING")
  notes            String?
  createdAt        DateTime @default(now())

  promotion Promotion @relation("PromotionStudents", fields: [promotionId], references: [id], onDelete: Cascade)
  student   Student   @relation("PromotionStudents", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([studentId])
  @@map("promotion_students")
}

// ============================================================================
// FINANCE ENUMS
// ============================================================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  NONE
}

enum FeeType {
  TUITION
  TRANSPORT
  MEALS
  UNIFORM
  EXAM
  ACTIVITY
  BOARDING
  OTHER
}

enum PaymentMethod {
  CASH
  MPESA
  BANK_TRANSFER
  CHEQUE
  CARD
  WALLET
  ONLINE
}

// ============================================================================
// FINANCE MODELS
// ============================================================================

model FeeStructure {
  id              String   @id @default(cuid())
  institutionId   String
  name            String
  gradeId         String?
  academicYearId  String
  termId          String?
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution Institution @relation("InstitutionFeeStructures", fields: [institutionId], references: [id], onDelete: Cascade)
  grade         Grade?    @relation("GradeFeeStructures", fields: [gradeId], references: [id], onDelete: SetNull)
  academicYear  AcademicYear @relation("AcademicYearFeeStructures", fields: [academicYearId], references: [id], onDelete: Cascade)
  term          Term?     @relation("TermFeeStructures", fields: [termId], references: [id], onDelete: SetNull)
  feeItems      FeeItem[] @relation("FeeStructureFeeItems")
  invoices      Invoice[] @relation("FeeStructureInvoices")

  @@index([institutionId])
  @@index([gradeId])
  @@index([academicYearId])
  @@map("fee_structures")
}

model FeeItem {
  id               String   @id @default(cuid())
  feeStructureId   String
  name             String // e.g., "Tuition", "Transport", "Meals", "Uniform"
  type             FeeType
  amount           Decimal
  isOptional       Boolean  @default(false)
  isRecurring      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  feeStructure FeeStructure @relation("FeeStructureFeeItems", fields: [feeStructureId], references: [id], onDelete: Cascade)
  invoiceLines InvoiceLine[] @relation("FeeItemInvoiceLines")

  @@index([feeStructureId])
  @@map("fee_items")
}

model Invoice {
  id               String   @id @default(cuid())
  institutionId    String
  studentId        String
  termId           String?
  academicYearId   String
  feeStructureId   String?
  invoiceNumber    String  @unique
  issueDate        DateTime
  dueDate          DateTime
  subtotal         Decimal
  discountAmount   Decimal @default(0)
  discountType     DiscountType @default(NONE)
  totalAmount      Decimal
  amountRemaining  Decimal
  status           InvoiceStatus @default(DRAFT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institution Institution @relation("InstitutionInvoices", fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student   @relation("StudentInvoices", fields: [studentId], references: [id], onDelete: Cascade)
  term        Term?     @relation("TermInvoices", fields: [termId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation("AcademicYearInvoices", fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation("FeeStructureInvoices", fields: [feeStructureId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[] @relation("InvoiceInvoiceLines")
  payments    Payment[]   @relation("PaymentInvoices")

  @@index([institutionId])
  @@index([studentId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id           String   @id @default(cuid())
  invoiceId    String
  feeItemId    String
  description  String?
  quantity     Int      @default(1)
  unitAmount   Decimal
  lineAmount   Decimal
  createdAt    DateTime @default(now())

  invoice Invoice @relation("InvoiceInvoiceLines", fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItem FeeItem @relation("FeeItemInvoiceLines", fields: [feeItemId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([feeItemId])
  @@map("invoice_lines")
}

model Payment {
  id               String   @id @default(cuid())
  institutionId    String
  invoiceId        String
  studentId        String
  amount           Decimal
  method           PaymentMethod
  reference        String?
  transactionDate  DateTime @default(now())
  recordedById     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institution Institution @relation("InstitutionPayments", fields: [institutionId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation("PaymentInvoices", fields: [invoiceId], references: [id], onDelete: Cascade)
  student   Student   @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  receipt   Receipt?  @relation("PaymentReceipt")

  @@index([institutionId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([method])
  @@map("payments")
}

model Receipt {
  id             String   @id @default(cuid())
  institutionId  String
  paymentId      String  @unique
  receiptNumber  String  @unique
  issuedDate     DateTime @default(now())
  issuedById     String?
  createdAt      DateTime @default(now())

  institution Institution @relation("InstitutionReceipts", fields: [institutionId], references: [id], onDelete: Cascade)
  payment   Payment   @relation("PaymentReceipt", fields: [paymentId], references: [id], onDelete: Cascade)
  issuedBy  User?     @relation("ReceiptIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@map("receipts")
}

model Budget {
  id          String   @id @default(cuid())
  institutionId String
  academicYearId String
  name        String
  category    String
  allocated   Decimal
  spent       Decimal  @default(0)
  status      String   @default("ACTIVE") // ACTIVE, EXHAUSTED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institution Institution @relation("InstitutionBudgets", fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation("AcademicYearBudgets", fields: [academicYearId], references: [id], onDelete: Cascade)
  lines       BudgetLine[] @relation("BudgetBudgetLines")

  @@index([institutionId])
  @@index([academicYearId])
  @@map("budgets")
}

model BudgetLine {
  id           String   @id @default(cuid())
  budgetId     String
  item         String
  amount       Decimal
  spent        Decimal  @default(0)
  createdAt    DateTime @default(now())

  budget Budget @relation("BudgetBudgetLines", fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("budget_lines")
}

model Transaction {
  id           String   @id @default(cuid())
  institutionId String
  reference    String  @unique
  type         String // e.g., "INCOME", "EXPENSE", "TRANSFER", "REFUND"
  amount       Decimal
  currency     String  @default("KES")
  description  String?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  institution Institution @relation("InstitutionTransactions", fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([type])
  @@index([date])
  @@map("transactions")
}

