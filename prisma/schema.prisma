enum InstitutionMembershipStatus {
 ACTIVE
 INACTIVE
 PENDING
 REVOKED
}

model InstitutionMembership {
 id  String @id @default(cuid())
 institutionId String
 userId String
 role  String // e.g., "ADMIN", "TEACHER", "STUDENT", "GUARDIAN"
 joinedAt DateTime @default(now())
  status InstitutionMembershipStatus @default(ACTIVE)

  institution Institution @relation("InstitutionMemberships", fields: [institutionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 userRoles UserRole[] @relation("InstitutionMembershipUserRoles")

 @@unique([institutionId, userId])
 @@index([institutionId])
 @@index([userId])
 @@map("institution_memberships")
}

enum NotificationType {
 SYSTEM
 SECURITY
 ACADEMIC
 DISCIPLINE
 FINANCIAL
 GIVING
 EVENT
 CONSENT
}

model Notification {
 id  String @id @default(cuid())
 institutionId String?
 userId String
 sentById String?
 type  NotificationType
 title  String
 message String @db.Text
 read  Boolean @default(false)
 readAt DateTime?
 createdAt DateTime @default(now())
 metadata Json @default("{}")

 institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
 user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
 sentBy User? @relation("NotificationSender", fields: [sentById], references: [id], onDelete: SetNull)

 @@index([userId])
 @@index([read])
 @@index([createdAt])
 @@map("notifications")
}

enum BackgroundJobStatus {
 PENDING
 PROCESSING
 COMPLETED
 FAILED
 CANCELLED
}

model BackgroundJob {
 id  String @id @default(cuid())
 institutionId String?
  jobType  JobType // e.g., "EMAIL", "SMS", "REPORT", "SYNC"
 status  BackgroundJobStatus @default(PENDING)
 payload  Json @default("{}")
 errorMessage String?
  attempts Int @default(0)
  maxAttempts Int @default(3)
  priority Int @default(0)
  nextRunAt  DateTime?
 completedAt DateTime?
 createdAt  DateTime @default(now())
 completedById String?
 creatorId  String?
 assigneeId  String?

 institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
 creator User? @relation("JobCreator", fields: [creatorId], references: [id], onDelete: SetNull)
 assignee User? @relation("JobAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

 @@index([status])
 @@index([nextRunAt])
 @@map("background_jobs")
}

enum DocumentCategory {
 IDENTITY
 ACADEMIC
 FINANCIAL
 CONSENT
 DISCIPLINE
 OTHER
}

model Document {
 id  String @id @default(cuid())
 institutionId String
 title  String
 category DocumentCategory
 path  String // S3 path or file location
 mimeType String
 size  Int @default(0)
 uploaderId String?
 uploadedAt DateTime @default(now())
 expiresAt DateTime?
 isActive Boolean @default(true)

 institution Institution @relation("InstitutionDocuments", fields: [institutionId], references: [id], onDelete: Cascade)
 uploader User? @relation("DocumentOwner", fields: [uploaderId], references: [id], onDelete: SetNull)

 @@index([category])
 @@index([isActive])
 @@map("documents")
}

enum TicketCategory {
 GENERAL
 ACADEMIC
 FINANCIAL
 DISCIPLINE
 FACILITY
 OTHER
}

model Ticket {
 id  String @id @default(cuid())
 institutionId String
 category TicketCategory
 title  String
 description String? @db.Text
 status  String @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
 priority String @default("MEDIUM") // LOW, MEDIUM, HIGH
 createdAt DateTime @default(now())
 resolvedAt DateTime?
  createdById String
  assignedById String?

  institution Institution @relation("InstitutionTickets", fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy User @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
 assignedBy User? @relation("TicketAssignee", fields: [assignedById], references: [id], onDelete: SetNull)
 comments TicketComment[]

 @@index([status])
 @@index([priority])
 @@index([createdAt])
 @@map("tickets")
}

model TicketComment {
 id  String @id @default(cuid())
 ticketId String
 commenterId String // 👈 Tracks the User account who created the comment
 studentId String? // 👈 Tracks the optional Student profile attached to it
 message  String @db.Text
 createdAt DateTime @default(now())
 
 // Cleanly separated relationships mapping to their own distinct fields:
 createdBy User @relation("CommentAuthor", fields: [commenterId], references: [id], onDelete: Cascade)
 student  Student? @relation("StudentTicketComments", fields: [studentId], references: [id], onDelete: SetNull)
 ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

 @@unique([ticketId, commenterId, createdAt])
 @@index([ticketId])
 @@index([createdAt])
 @@map("ticket_comments")
}

enum SchoolRelationType {
 ADMISSION
 ENROLMENT
 GRADE_ASSIGNMENT
 TRANSFER
 WITHDRAWAL
}

model SchoolRelation {
 id  String @id @default(cuid())
 institutionId String
 type  SchoolRelationType
 relatedId String // Related record ID
 details  String?
  createdAt DateTime @default(now())

  institution Institution @relation("InstitutionSchoolRelations", fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, type, relatedId])
  @@index([institutionId])
  @@index([type])
  @@map("school_relations")
}

enum ParishRelationType {
