 book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
 student Student @relation("StudentBorrows", fields: [studentId], references: [id], onDelete: Cascade, map: "borrow_record_student_fkey")

 @@unique([bookId, studentId, status])
 @@index([bookId])
 @@index([studentId])
