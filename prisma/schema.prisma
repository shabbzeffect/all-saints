// ============================================================================
// CORE TABLES - PLATFORM SHARED (expanded)
// ============================================================================

model User {
 id  String  @id @default(cuid())
 email  String  @unique
 emailVerified DateTime?
 phone  String?  @unique
 phoneVerified DateTime?
 passwordHash String?
 name  String?
 avatarUrl  String?
 status  UserStatus @default(PENDING_VERIFICATION)
 timezone  String  @default("Africa/Nairobi")
 locale  String  @default("en-KE")
 mfaEnabled Boolean  @default(false)
 mfaSecret  String?  @db.Text
 backupCodes String[] @default([])
 lastLoginAt DateTime?
 lastLoginIp String?
 failedLoginAttempts Int  @default(0)
 lockedUntil DateTime?
 createdAt  DateTime @default(now())
 updatedAt  DateTime @updatedAt
 deletedAt  DateTime?

 wing  Wing  @default(SHARED)
 institutionId String?  // FK to Institution.id, nullable for SHARED/wingless records

 // Relations
 memberships InstitutionMembership[]
 roles  UserRole[] @relation("UserRoles")
 sessions  Session[]
 auditEvents AuditEvent[] @relation("AuditActor")
 targetEvents AuditEvent[] @relation("AuditTarget")
 sentNotifications Notification[] @relation("NotificationSender")
 receivedNotifications Notification[] @relation("NotificationRecipient")
 createdJobs BackgroundJob[] @relation("JobCreator")
 assignedJobs BackgroundJob[] @relation("JobAssignee")
 documents  Document[] @relation("DocumentOwner")
 tickets  Ticket[] @relation("TicketCreator")
 assignedTickets Ticket[] @relation("TicketAssignee")
 ticketsComments TicketComment[] @relation("CommentAuthor")
 academicYears AcademicYear[] @relation("AcademicYearsCreated")
 subjects  Subject[] @relation("SubjectsCreated")
 assessments Assessment[] @relation("AssessmentsCreated")
 reportCards ReportCard[] @relation("ReportIssuedBy")
 timetables Timetable[] @relation("TimetablesCreated")
 lessonPlans LessonPlan[] @relation("LessonPlansCreated")
 disciplineIncidents DisciplineIncident[] @relation("DisciplineReporter")
 clubs  Club[] @relation("ClubLeaders")
 staffs  Staff? @relation("StaffMember")
  grantedPermissions RolePermission[] @relation("GrantedPermissions")
  timetableLines TimetableLine[] @relation("TimetableTeachers")
  assignedUserRoles UserRole[] @relation("AssignedRoles")
  consentPreferences ConsentPreference[] @relation("UserConsentPreferences")
  guardians  Guardian[] @relation("GuardianUsers")
  students   Student[] @relation("StudentUsers")
  payments   Payment[] @relation("PaymentRecorder")
  receipts   Receipt[] @relation("ReceiptIssuer")

  @@index([status])
  @@index([wing, institutionId])
  @@map("users")
}

model Session {
 id  String @id @default(cuid())
 sessionToken String @unique
 userId String
 expires DateTime
 ipAddress String?
 userAgent String?
 deviceName String?
 isCurrent Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)

 @@index([userId])
 @@index([expires])
 @@map("sessions")
}

model VerificationToken {
 identifier String
 token String @unique
 expires DateTime
 type String // email_verification | phone_verification | password_reset | mfa_setup

 @@unique([identifier, token])
 @@map("verification_tokens")
}

model Institution {
 id  String  @id @default(cuid())
 name String
 slug String  @unique
 type InstitutionType
 status InstitutionStatus @default(ACTIVE)
 description String?
 logoUrl String?
 address String?
 city String?
 county String?
 country String  @default("KE")
 phone String?
 email String?
 website String?
 timezone String  @default("Africa/Nairobi")
 currency String  @default("KES")
 dateFormat String  @default("dd/MM/yyyy")
 settings Json  @default("{}")
 createdAt DateTime  @default(now())
 updatedAt DateTime  @updatedAt
 deletedAt DateTime?

 memberships InstitutionMembership[] @relation("InstitutionMemberships") 
 roles  Role[] @relation("InstitutionRoles") 
 schoolRelations SchoolRelation[] @relation("InstitutionSchoolRelations") 
 parishRelations ParishRelation[] @relation("InstitutionParishRelations") 
 notifications Notification[]
 backgroundJobs BackgroundJob[]
 auditEvents AuditEvent[] @relation("InstitutionAuditEvents") 
 academicYears AcademicYear[] @relation("InstitutionAcademicYears") 
 terms Term[] @relation("InstitutionTerms") 
 grades Grade[] @relation("InstitutionGrades") 
 subjects Subject[] @relation("InstitutionSubjects") 
 assessments Assessment[] @relation("InstitutionAssessments") 
 assessmentScores AssessmentScore[] @relation("InstitutionAssessmentScores") 
 timetables Timetable[] @relation("InstitutionTimetables") 
 lessonPlans LessonPlan[] @relation("InstitutionLessonPlans") 
 disciplineIncidents DisciplineIncident[] @relation("InstitutionDisciplineIncidents") 
 clubs Club[] @relation("InstitutionClubs") 
 clubMembers ClubMember[] @relation("InstitutionClubMembers") 
 kpseaRegistrations KPSEARegistration[] @relation("InstitutionKPSEARegistrations") 
 kjseaRegistrations KJSEARegistration[] @relation("InstitutionKJSEARegistrations") 
 staffRoles StaffRole[] @relation("InstitutionStaffRoles") 
 employmentTypes EmploymentType[] @relation("InstitutionEmploymentTypes") 
 leaveTypes LeaveType[] @relation("InstitutionLeaveTypes") 
 statutoryDeductions StatutoryDeduction[] @relation("InstitutionStatutoryDeductions") 
 consentPreferences ConsentPreference[] @relation("InstitutionConsentPreferences") 
 dormitories Dormitory[] @relation("InstitutionDormitories") 
 boardingFees BoardingFee[] @relation("InstitutionBoardingFees") 
 dormitoryRules DormitoryRule[] @relation("InstitutionDormitoryRules") 
 vehicles Vehicle[] @relation("InstitutionVehicles") 
 routes Route[] @relation("InstitutionRoutes") 
 transportFees TransportFee[] @relation("InstitutionTransportFees") 
 books Book[] @relation("InstitutionBooks") 
 libraryFines LibraryFine[] @relation("InstitutionLibraryFines") 
 libraryCategories LibraryCategory[] @relation("InstitutionLibraryCategories") 
 students Student[] @relation("InstitutionStudents") 
 attendances Attendance[] @relation("InstitutionAttendances") 
 schoolCalendarEvents SchoolCalendarEvent[] @relation("InstitutionSchoolCalendarEvents") 
  documents Document[] @relation("InstitutionDocuments")
  tickets Ticket[] @relation("InstitutionTickets")
  streams StreamEntry[] @relation("InstitutionStreams")
  reportCards ReportCard[] @relation("InstitutionReportCards")
  staffs Staff[] @relation("InstitutionStaff")
  guardians Guardian[] @relation("InstitutionGuardians")
  studentGuardians StudentGuardian[] @relation("InstitutionStudentGuardians")
  admissions Admission[] @relation("InstitutionAdmissions")
  enrolments Enrolment[] @relation("InstitutionEnrolments")
  promotions Promotion[] @relation("InstitutionPromotions")
  feeStructures FeeStructure[] @relation("InstitutionFeeStructures")
  invoices Invoice[] @relation("InstitutionInvoices")
  payments Payment[] @relation("InstitutionPayments")
  receipts Receipt[] @relation("InstitutionReceipts")
  budgets Budget[] @relation("InstitutionBudgets")
  transactions Transaction[] @relation("InstitutionTransactions")

  @@index([slug])
  @@index([type])
  @@index([status])
 @@map("institutions")
}

// ============================================================================
// RBAC (with academic permissions)
// ============================================================================

model Permission {
 id  String  @id @default(cuid())
 key  String  @unique // e.g., "school:assessments:read"
 name String  // e.g., "Manage Assessments"
 description String?
 scope PermissionScope @default(INSTITUTION)
 resource String  // e.g., "students", "finance", "members", "academics"
 action String  // e.g., "create", "read", "update", "delete", "export"
 isSystem Boolean  @default(false)
 createdAt DateTime  @default(now())
 updatedAt DateTime  @updatedAt

 rolePermissions RolePermission[]

 @@index([resource])
 @@index([action])
 @@map("permissions")
}

model Role {
 id  String @id @default(cuid())
 institutionId String
 key  String // e.g., "SCHOOL_PRINCIPAL", "PARISH_TREASURER", "SCHOOL_TEACHER"
 name  String // e.g., "School Principal"
 description String?
 isSystem Boolean @default(false)
 priority Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 institution Institution @relation("InstitutionRoles", fields: [institutionId], references: [id], onDelete: Cascade, map: "role_institution_fkey")
 permissions RolePermission[]
 userRoles UserRole[] @relation("UserRoleRole", map: "user_role_role_fkey")

 @@unique([institutionId, key])
 @@index([institutionId])
 @@map("roles")
}

model RolePermission {
 id  String @id @default(cuid())
 roleId String
 permissionId String
 grantedAt DateTime @default(now())
 grantedById String?

 role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
 permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
 grantedBy User? @relation("GrantedPermissions", fields: [grantedById], references: [id])

 @@unique([roleId, permissionId])
 @@index([roleId])
 @@index([permissionId])
 @@map("role_permissions")
}

model UserRole {
 id   String @id @default(cuid())
 userId  String
 roleId  String
 membershipId String
 assignedAt  DateTime @default(now())
 assignedById String?
 staffRoleId String?
 expiresAt  DateTime?
 isActive  Boolean @default(true)

 user User   @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
 role Role   @relation("UserRoleRole", fields: [roleId], references: [id], onDelete: Cascade, map: "user_role_role_fkey")
 membership InstitutionMembership @relation("InstitutionMembershipUserRoles", fields: [membershipId], references: [id], onDelete: Cascade)
 assignedBy User?  @relation("AssignedRoles", fields: [assignedById], references: [id])
 staffRole StaffRole? @relation("StaffRoleUserRole", fields: [staffRoleId], references: [id], map: "staff_role_user_role_fkey")

 @@unique([userId, roleId, membershipId])
 @@index([userId])
 @@index([roleId])
 @@index([membershipId])
 @@index([isActive])
 @@map("user_roles")
}

// ============================================================================
// AUDIT LOG (expanded)
// ============================================================================

model AuditEvent {
 id  String @id @default(cuid())
 actorId  String?
 institutionId String?
 action  AuditAction
 targetType String // e.g., "Student", "Assessment", "ReportCard", "Timetable"
 targetId String?
 targetName String?
 oldValues Json?
 newValues Json?
 metadata Json @default("{}")
 ipAddress String?
 userAgent String?
 requestId String? // Correlation ID
 sessionId String?
 createdAt DateTime @default(now())

 actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
 institution Institution? @relation("InstitutionAuditEvents", fields: [institutionId], references: [id], onDelete: SetNull)
 target User? @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

 @@index([actorId])
 @@index([institutionId])
 @@index([action])
 @@index([targetType, targetId])
 @@index([createdAt])
 @@index([requestId])
 @@map("audit_events")
}

// ============================================================================
// ACADEMICS DOMAIN MODELS (Phase 4)
// ============================================================================

// Academic Year
model AcademicYear {
 id  String @id @default(cuid())
 institutionId String
 name  String // e.g., "2024 academic year"
 startDate DateTime
 endDate DateTime
 termCount Int @default(3)
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 createdById String

 institution Institution @relation("InstitutionAcademicYears", fields: [institutionId], references: [id], onDelete: Cascade, map: "academic_year_institution_fkey")
 createdBy User @relation("AcademicYearsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  terms Term[] @relation("AcademicYearTerms")
  grades Grade[] @relation("AcademicYearGrades")
  reportCards ReportCard[] @relation("AcademicYearReportCards")
  promotions Promotion[] @relation("AcademicYearPromotions")
  feeStructures FeeStructure[] @relation("AcademicYearFeeStructures")
  invoices Invoice[] @relation("AcademicYearInvoices")
  budgets Budget[] @relation("AcademicYearBudgets")

  @@index([institutionId])
 @@map("academic_years")
}

// Term
model Term {
 id  String @id @default(cuid())
 academicYearId String
 institutionId String
 name  String // e.g., "Term 1", "Term 2", "Term 3"
 ordinal Int // 1, 2, 3
 startDate DateTime
 endDate DateTime
 isCurrent Boolean @default(false)
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

  academicYear AcademicYear @relation("AcademicYearTerms", fields: [academicYearId], references: [id], onDelete: Cascade)
  institution Institution @relation("InstitutionTerms", fields: [institutionId], references: [id], onDelete: Cascade)
  students Student[] @relation("TermStudents")
  assessments Assessment[] @relation("TermAssessments")
  attendance Attendance[] @relation("TermAttendance")
  calendarEvents SchoolCalendarEvent[] @relation("TermCalendarEvents")
  reportCards ReportCard[] @relation("TermReportCards")
  lessonPlans LessonPlan[] @relation("TermLessonPlans")
  enrolments Enrolment[] @relation("TermEnrolments")
  promotions Promotion[] @relation("TermPromotions")
  feeStructures FeeStructure[] @relation("TermFeeStructures")
  invoices Invoice[] @relation("TermInvoices")

  @@unique([academicYearId, ordinal])
  @@index([academicYearId])
  @@index([isCurrent])
  @@map("terms")
}

// Grade
model Grade {
 id  String @id @default(cuid())
 institutionId String
 name  String // e.g., "Grade 1", "Grade 7", "PP1"
 level  String // PP1, PP2, GRADE_1-6, GRADE_7-9
 formTeacher String?
 roomNumber String?
 capacity Int
 currentStudentCount Int @default(0)
 academicYearId String
 institution Institution @relation("InstitutionGrades", fields: [institutionId], references: [id], onDelete: Cascade)
 academicYear AcademicYear @relation("AcademicYearGrades", fields: [academicYearId], references: [id], onDelete: Cascade)
  stream StreamEntry? @relation("GradeStream")
  assessments Assessment[] @relation("GradeAssessments")
  reportCards ReportCard[] @relation("GradeReportCards")
  lessonPlans LessonPlan[] @relation("GradeLessonPlans")
  students Student[] @relation("StudentCurrentGrade")
  enrolments Enrolment[] @relation("GradeEnrolments")
  feeStructures FeeStructure[] @relation("GradeFeeStructures")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, name])
 @@index([institutionId])
 @@index([level])
 @@index([academicYearId])
 @@map("grades")
}

// Stream
model StreamEntry {
 id  String @id @default(cuid())
 gradeId String @unique
 institutionId String
 name  String // e.g., "Stream A", "Stream B", "Stream MAIN"
 level  String // MAIN, SUPPORT, ACCELERATED
 capacity Int
 currentStudentCount Int @default(0)
 grade  Grade @relation("GradeStream", fields: [gradeId], references: [id], onDelete: Cascade)
